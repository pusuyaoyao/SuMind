<Application x:Class="SuMind.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Replace WPF's dotted keyboard focus rectangle with a solid system-color outline. -->
        <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="1" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
