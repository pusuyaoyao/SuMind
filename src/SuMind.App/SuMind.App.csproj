<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\SuMind-logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SuMind.Shared\SuMind.Shared.csproj" />
    <ProjectReference Include="..\SuMind.Packages\SuMind.Packages.csproj" />
    <Resource Include="..\..\assets\SuMind-logo.ico" Link="Assets\SuMind-logo.ico" />
  </ItemGroup>
</Project>

